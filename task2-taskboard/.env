# Non-secret local settings, loaded by `npm start`. Variables already set in the shell take precedence.
PORT=3001
# How often the mock "other side" changes a random task
SIMULATOR_INTERVAL_MS=4000
# Activity feed length on the server (and mirrored on the client)
MAX_ACTIVITY=50
# Same value, exposed to the Vue client (Vite only reads VITE_* into the browser)
VITE_MAX_ACTIVITY=50
# Simulator keeps the board between these sizes
MIN_TASKS=3
MAX_TASKS=15
# SSE comment line that keeps proxies from closing an idle connection
SSE_HEARTBEAT_MS=15000
