{
  "name": "task2-taskboard",
  "version": "1.0.0",
  "private": true,
  "description": "Team task board with shared state: Vue 3 + Pinia client, Node.js mock server with Server-Sent Events",
  "type": "module",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "prestart": "npm install --no-audit --no-fund --loglevel=error",
    "start": "concurrently --kill-others --names server,client --prefix-colors blue,green \"tsx server/index.ts\" \"vite --open\"",
    "pretest": "npm install --no-audit --no-fund --loglevel=error",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "fastify": "^5.12.8",
    "pinia": "^4.1.0",
    "vue": "^3.5.46"
  },
  "devDependencies": {
    "@types/node": "^22.20.7",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.6.0",
    "concurrently": "^10.0.7",
    "happy-dom": "^21.0.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.2",
    "vue-tsc": "^3.3.14"
  }
}
