{
  "name": "task1-metering",
  "version": "1.0.0",
  "private": true,
  "description": "AI usage metering & quota service",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prestart": "npm install --no-audit --no-fund --loglevel=error",
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "pretest": "npm install --no-audit --no-fund --loglevel=error",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/swagger": "^9.9.5",
    "@fastify/swagger-ui": "^6.1.5",
    "ajv": "^8.20.0",
    "better-sqlite3": "^13.2.0",
    "fastify": "^5.12.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.19.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  }
}
