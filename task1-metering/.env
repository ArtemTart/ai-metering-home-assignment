# Non-secret local settings, loaded by `npm start`. Variables already set in the shell take precedence.
PORT=3000
DB_PATH=data/metering.db
DEFAULT_CREDIT_LIMIT=5
# hour | day | month (calendar-aligned, UTC)
QUOTA_PERIOD=month
# Requests without an Idempotency-Key: same user + same prompt within this many seconds = a retry (0 = off)
DEDUPE_WINDOW_SECONDS=10
AI_MIN_DELAY_MS=200
AI_MAX_DELAY_MS=1500
AI_FAILURE_RATE=0.2
AI_TIMEOUT_MS=3000
